    | linear_combination ((1 : ℂ) * (Real.sqrt 3 : ℂ) * Complex.I + (1 : ℂ) * (Real.sqrt 3 : ℂ) * Complex.I ^ 2) * h2 + ((2 : ℂ) * (Real.sqrt 3 : ℂ)) * hI

