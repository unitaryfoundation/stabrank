  all_goals first
    | ring1
    | linear_combination ((1 : ℂ) + (1 : ℂ) * (Real.sqrt 3 : ℂ)) * h2
    | linear_combination ((1 : ℂ) * (Real.sqrt 2 : ℂ)) * h3
    | linear_combination ((1 : ℂ) * (Real.sqrt 3 : ℂ) + (1 : ℂ) * (Real.sqrt 3 : ℂ) ^ 2) * h2 + ((2 : ℂ)) * h3
    | linear_combination ((1 : ℂ) * Complex.I + (1 : ℂ) * (Real.sqrt 3 : ℂ) * Complex.I) * h2
    | linear_combination ((1 : ℂ) * (Real.sqrt 2 : ℂ) * Complex.I) * h3
    | linear_combination ((1 : ℂ) * (Real.sqrt 3 : ℂ) * Complex.I + (1 : ℂ) * (Real.sqrt 3 : ℂ) ^ 2 * Complex.I) * h2 + ((2 : ℂ) * Complex.I) * h3

